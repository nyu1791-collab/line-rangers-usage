<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>LINEレンジャー 使用率</title>
</head>
<body>
    <h1>LINEレンジャー 使用率チェッカー</h1>
    <div id="content">データを読み込み中...</div>

    <script>
        fetch('./data/current.json')
            .then(response => response.json())
            .then(data => {
                const contentDiv = document.getElementById('content');
                contentDiv.innerHTML = `
                    <p>最終更新: ${data.updated_at}</p>
                    <p>ステータス: ${data.status}</p>
                    <p>詳細: ${data.details}</p>
                `;
            })
            .catch(error => {
                document.getElementById('content').innerText = 'データの読み込みに失敗しました。';
                console.error(error);
            });
    </script>
</body>
</html>
